# Copy to .env. Keep credentials server-side; never use a VITE_ prefix.
# API route and GDG credit scope are pending clarification. Google Cloud billing
# alone does not select Vertex. This template is not proof of model access.
PORT=3001
DEMO_MODE=true
AI_PROVIDER=gemini

# Gemini Developer API (AI Studio). GEMINI_API_KEY takes priority over GOOGLE_API_KEY.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

# Legacy text model alias. GEMMA_MODEL takes priority when both are set.
# GEMINI_TEXT_MODEL=gemma-4-31b-it

# Optional Vertex AI with local Application Default Credentials (ADC).
# Set AI_PROVIDER=vertex and explicitly set all three model IDs above.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
