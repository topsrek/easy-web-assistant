{
  "$schema": "https://a2ui.org/schemas/v0.9/catalog.json",
  "id": "https://easy-web-assistant.local/catalogs/everyday-v1.json",
  "version": "v0.9",
  "$defs": {
    "Image": { "type": "object", "properties": { "url": { "type": "string", "format": "uri", "pattern": "^https?://" }, "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }, "alt": { "type": "string", "maxLength": 500 } }, "required": ["url", "sourceUrl", "alt"], "additionalProperties": false },
    "Offer": { "type": "object", "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 100 }, "kind": { "enum": ["event", "journey", "appointment", "government", "service", "leisure"] }, "title": { "type": "string", "maxLength": 500 }, "provider": { "type": "string", "maxLength": 500 }, "subtitle": { "type": "string", "maxLength": 500 }, "price": { "type": ["number", "null"], "minimum": 0 }, "currency": { "enum": ["USD", "EUR", "GBP"] }, "priceLabel": { "type": "string", "maxLength": 500 }, "unknownCosts": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } }, "facts": { "type": "array", "maxItems": 100, "items": { "type": "object", "properties": { "label": { "type": "string", "maxLength": 500 }, "value": { "type": "string", "maxLength": 3000 }, "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }, "completeness": { "enum": ["complete", "partial", "unknown"] } }, "required": ["label", "value"], "additionalProperties": false } }, "details": { "type": "array", "maxItems": 100, "items": { "type": "object", "properties": { "title": { "type": "string", "maxLength": 500 }, "text": { "type": "string", "maxLength": 6000 }, "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }, "completeness": { "enum": ["complete", "partial", "unknown"] } }, "required": ["title", "text"], "additionalProperties": false } }, "images": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/Image" } }, "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https?://" }, "observedAt": { "type": "string", "format": "date-time" }, "demo": { "type": "boolean" }, "selectLabel": { "type": "string", "maxLength": 500 }, "completeness": { "enum": ["complete", "partial", "unknown"] } }, "required": ["id", "kind", "title", "provider", "subtitle", "price", "currency", "priceLabel", "unknownCosts", "facts", "details", "images", "sourceUrl", "observedAt", "demo", "selectLabel"], "additionalProperties": false },
    "EventOffer": { "allOf": [{ "$ref": "#/$defs/Offer" }, { "properties": { "kind": { "const": "event" } } }] },
    "JourneyOffer": { "allOf": [{ "$ref": "#/$defs/Offer" }, { "properties": { "kind": { "const": "journey" } } }] },
    "AppointmentOffer": { "allOf": [{ "$ref": "#/$defs/Offer" }, { "properties": { "kind": { "const": "appointment" } } }] },
    "GovernmentOffer": { "allOf": [{ "$ref": "#/$defs/Offer" }, { "properties": { "kind": { "const": "government" } } }] },
    "ServiceOffer": { "allOf": [{ "$ref": "#/$defs/Offer" }, { "properties": { "kind": { "const": "service" } } }] },
    "LeisureOffer": { "allOf": [{ "$ref": "#/$defs/Offer" }, { "properties": { "kind": { "const": "leisure" } } }] },
    "LegacyOffer": { "allOf": [{ "$ref": "#/$defs/Offer" }, { "properties": { "kind": { "enum": ["event", "journey", "appointment"] } } }] }
  },
  "components": {
    "EventCard": { "type": "object", "properties": { "offer": { "$ref": "#/$defs/EventOffer" }, "disabled": { "$ref": "common_types.json#/$defs/DynamicBoolean" }, "onSelect": { "$ref": "common_types.json#/$defs/Action" } }, "required": ["offer", "disabled", "onSelect"], "additionalProperties": false },
    "JourneyCard": { "type": "object", "properties": { "offer": { "$ref": "#/$defs/JourneyOffer" }, "disabled": { "$ref": "common_types.json#/$defs/DynamicBoolean" }, "onSelect": { "$ref": "common_types.json#/$defs/Action" } }, "required": ["offer", "disabled", "onSelect"], "additionalProperties": false },
    "AppointmentCard": { "type": "object", "properties": { "offer": { "$ref": "#/$defs/AppointmentOffer" }, "disabled": { "$ref": "common_types.json#/$defs/DynamicBoolean" }, "onSelect": { "$ref": "common_types.json#/$defs/Action" } }, "required": ["offer", "disabled", "onSelect"], "additionalProperties": false },
    "GovernmentCard": { "type": "object", "properties": { "offer": { "$ref": "#/$defs/GovernmentOffer" }, "disabled": { "$ref": "common_types.json#/$defs/DynamicBoolean" }, "onSelect": { "$ref": "common_types.json#/$defs/Action" } }, "required": ["offer", "disabled", "onSelect"], "additionalProperties": false },
    "ServiceCard": { "type": "object", "properties": { "offer": { "$ref": "#/$defs/ServiceOffer" }, "disabled": { "$ref": "common_types.json#/$defs/DynamicBoolean" }, "onSelect": { "$ref": "common_types.json#/$defs/Action" } }, "required": ["offer", "disabled", "onSelect"], "additionalProperties": false },
    "LeisureCard": { "type": "object", "properties": { "offer": { "$ref": "#/$defs/LeisureOffer" }, "disabled": { "$ref": "common_types.json#/$defs/DynamicBoolean" }, "onSelect": { "$ref": "common_types.json#/$defs/Action" } }, "required": ["offer", "disabled", "onSelect"], "additionalProperties": false },
    "EverydayOffer": { "type": "object", "properties": { "offer": { "$ref": "#/$defs/LegacyOffer" }, "disabled": { "$ref": "common_types.json#/$defs/DynamicBoolean" }, "onSelect": { "$ref": "common_types.json#/$defs/Action" } }, "required": ["offer", "disabled", "onSelect"], "additionalProperties": false, "description": "Temporary compatibility alias for older server messages." },
    "ImageGallery": { "type": "object", "properties": { "images": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/Image" } }, "title": { "$ref": "common_types.json#/$defs/DynamicString" } }, "required": ["images", "title"], "additionalProperties": false },
    "FormTextField": { "type": "object", "properties": { "label": { "$ref": "common_types.json#/$defs/DynamicString" }, "value": { "$ref": "common_types.json#/$defs/DynamicString" }, "placeholder": { "$ref": "common_types.json#/$defs/DynamicString" }, "disabled": { "$ref": "common_types.json#/$defs/DynamicBoolean" } }, "required": ["label", "value"] },
    "FormChoicePicker": { "type": "object", "properties": { "label": { "$ref": "common_types.json#/$defs/DynamicString" }, "options": { "type": "array", "maxItems": 20, "items": { "type": "object", "properties": { "label": { "type": "string", "maxLength": 160 }, "value": { "type": "string", "maxLength": 160 } }, "required": ["label", "value"], "additionalProperties": false } }, "value": { "$ref": "common_types.json#/$defs/DynamicString" }, "disabled": { "$ref": "common_types.json#/$defs/DynamicBoolean" } }, "required": ["label", "options", "value"] }
  },
  "functions": {}
}
